NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/authify

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
JWT_REMEMBER_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_IN=10m

COOKIE_SECRET=replace-with-at-least-32-random-characters
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

BCRYPT_ROUNDS=12

CLIENT_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=AUTHIFY
EMAIL_FROM_ADDRESS=no-reply@authify.local

# Optional legacy fallback if you prefer one combined value:
# EMAIL_FROM="AUTHIFY <no-reply@authify.local>"

RATE_LIMIT_DISABLED=false

# Optional: only needed for scripts/migrate-mysql-users.js
LEGACY_MYSQL_HOST=
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DATABASE=
LEGACY_MYSQL_TABLE=tbl_users
LEGACY_MYSQL_SSL=false