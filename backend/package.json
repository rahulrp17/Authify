{
  "name": "authify-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AUTHIFY MERN authentication API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
