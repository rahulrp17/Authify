# Public app name
VITE_APP_NAME=AUTHIFY

# Base URL used by axios.
# Development: keep /api so Vite proxies requests to the backend.
# Production: set this to your deployed API URL, e.g. https://api.example.com/api
VITE_API_URL=/api

# Development-only target for the Vite /api proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
